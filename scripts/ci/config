# Sourced by the CI git hooks and by run.sh.
# Git pathspecs that must change for a commit/merge to trigger a run.
# Space-separated; empty means "watch everything".
# Override ad hoc from a shell with WSGW_CI_WATCH_PATHS.
WATCH_PATHS="wsgw e2e wsgw-contract wsgw-common"

# Git pathspecs that feed the gateway's build. A queued run tests only E2E_MODULES
# when none of these changed since the nearest first-parent ancestor that passed;
# otherwise, and for explicit requests, it runs the whole suite.
FULL_SUITE_PATHS="wsgw wsgw-contract wsgw-common pom.xml"

# Maven modules (paths) a narrowed run builds, with -am for what they depend on.
# Space-separated; add new e2e modules here.
E2E_MODULES="e2e/common e2e/app e2e/client e2e/quarkus-app"

# JUnit tags excluded from every run, explicit ones included: local CI covers the
# fast tiers, the slow ones are left to a full-cycle pipeline. Comma-separated.
# Override ad hoc from a shell with WSGW_CI_EXCLUDED_GROUPS; set it empty to run
# everything, e.g. `WSGW_CI_EXCLUDED_GROUPS= scripts/ci/run.sh HEAD`.
EXCLUDED_GROUPS="${WSGW_CI_EXCLUDED_GROUPS-slow}"
