#!/usr/bin/env bash
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Interactive rebase (lazygit's commit-reorder, squash, etc.) replays commits
# one at a time and fires this hook per replayed commit. post-rewrite handles
# the rebase as a whole once it finishes, so stay out of its way here.
if [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
  exit 0
fi

. "$REPO_ROOT/scripts/ci/config"
WATCH="${WSGW_CI_WATCH_PATHS:-$WATCH_PATHS}"

if [ -n "$WATCH" ]; then
  PREV="$(git rev-parse -q --verify 'HEAD@{1}' 2>/dev/null || true)"
  if [ -n "$PREV" ]; then
    CHANGED="$(git diff --name-only "$PREV" HEAD -- $WATCH)"
    [ -z "$CHANGED" ] && exit 0
  fi
fi

SHA="$(git rev-parse HEAD)"
setsid nohup "$REPO_ROOT/scripts/ci/run.sh" "$SHA" post-commit >/dev/null 2>&1 </dev/null &
disown
