<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Human-readable for tests. %kvp prints the bound key/value pairs
         (CtxLogger context) so you can see them without a JSON viewer. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %-24logger{36} %kvp - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Quiet by default: a load test emits millions of per-message events, and synchronous DEBUG
         logging both drowns the output and perturbs the timing under test.
         Pass -Dtest-logs=DEBUG on the mvn command line to bump — no need to edit this file. -->
    <logger name="io.github.pdkovacs.wsgw" level="${test.log.level:-INFO}"/>

</configuration>
