<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.pdkovacs</groupId>
        <artifactId>wsgw-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>wsgw-e2e</artifactId>
    <packaging>pom</packaging>

    <name>wsgw :: e2e</name>
    <description>End-to-end test harness for the wsgw gateway: the apps behind it and the client in front.</description>

    <modules>
        <module>app</module>
        <module>client</module>
        <module>quarkus-app</module>
    </modules>

    <properties>
        <!-- What the Quarkus BOM resolves today, so dropping that BOM doesn't also change Jackson.
             Here, not in the root: the gateway gets Jackson only transitively. -->
        <jackson.version>2.21.2</jackson.version>

        <!--
            Shared e2e configuration. quarkus-app's pom exports these to surefire/failsafe
            as environment variables, matching how that app consumes config
            via Quarkus ${ENV_VAR:default} interpolation in application.properties.
            Override per-module or on the command line, e.g. -De2e.http2=true.
            Pure-runtime secrets (OTLP credentials, etc.) belong in a shared .env
            beside this pom, not here.
        -->
        <e2e.http2>false</e2e.http2>
        <e2e.wsgw.host>localhost</e2e.wsgw.host>
        <e2e.wsgw.port>8080</e2e.wsgw.port>
        <!-- Test-only credentials for the harness; real deployments supply their own. -->
        <e2e.password.credentials>[{"username":"test","password":"test"}]</e2e.password.credentials>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
