<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.pdkovacs</groupId>
        <artifactId>wsgw-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>wsgw-e2e</artifactId>
    <packaging>pom</packaging>

    <name>wsgw :: e2e</name>
    <description>Quarkus-based end-to-end test harness for the wsgw gateway.</description>

    <modules>
        <module>app</module>
    </modules>

    <properties>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.35.4</quarkus.platform.version>

        <!--
            Shared e2e configuration. These are exported to surefire/failsafe as
            environment variables (below), matching how the app consumes config
            via Quarkus ${ENV_VAR:default} interpolation in application.properties.
            Override per-module or on the command line, e.g. -De2e.http2=true.
            Pure-runtime secrets (OTLP credentials, etc.) belong in a shared .env
            beside this pom, not here.
        -->
        <e2e.http2>false</e2e.http2>
        <e2e.wsgw.host>localhost</e2e.wsgw.host>
        <e2e.wsgw.port>8080</e2e.wsgw.port>
        <!-- Test-only credentials for the harness; real deployments supply their own. -->
        <e2e.password.credentials>[{"username":"test","password":"test"}]</e2e.password.credentials>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.quarkus.platform</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>

                <!--
                    surefire runs @QuarkusTest classes (*Test) in the test phase;
                    failsafe runs @QuarkusIntegrationTest classes (*IT) against the
                    packaged artifact in the integration-test/verify phases. Both
                    receive the shared e2e config as environment variables so the
                    app (and the tests) resolve them identically to a real run.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <!-- Required by @QuarkusTest: JBoss LogManager must be
                                 installed before JUL initializes, or tests error out. -->
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        </systemPropertyVariables>
                        <environmentVariables>
                            <E2EAPP_HTTP2>${e2e.http2}</E2EAPP_HTTP2>
                            <E2EAPP_WSGW_HOST>${e2e.wsgw.host}</E2EAPP_WSGW_HOST>
                            <E2EAPP_WSGW_PORT>${e2e.wsgw.port}</E2EAPP_WSGW_PORT>
                        </environmentVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <!--
                                @QuarkusIntegrationTest launches the *packaged* app as a
                                separate process, so failsafe's own <environmentVariables>
                                do not reach it. Quarkus forwards quarkus.test.env.* as
                                environment variables into that launched process, which is
                                how the app's required E2EAPP_* config gets there.
                            -->
                            <quarkus.test.env.E2EAPP_HTTP2>${e2e.http2}</quarkus.test.env.E2EAPP_HTTP2>
                            <quarkus.test.env.E2EAPP_WSGW_HOST>${e2e.wsgw.host}</quarkus.test.env.E2EAPP_WSGW_HOST>
                            <quarkus.test.env.E2EAPP_WSGW_PORT>${e2e.wsgw.port}</quarkus.test.env.E2EAPP_WSGW_PORT>
                            <quarkus.test.env.E2EAPP_PASSWORD_CREDENTIALS>${e2e.password.credentials}</quarkus.test.env.E2EAPP_PASSWORD_CREDENTIALS>
                        </systemPropertyVariables>
                        <environmentVariables>
                            <E2EAPP_HTTP2>${e2e.http2}</E2EAPP_HTTP2>
                            <E2EAPP_WSGW_HOST>${e2e.wsgw.host}</E2EAPP_WSGW_HOST>
                            <E2EAPP_WSGW_PORT>${e2e.wsgw.port}</E2EAPP_WSGW_PORT>
                        </environmentVariables>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
